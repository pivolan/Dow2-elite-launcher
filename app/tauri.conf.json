{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Elite Launcher",
  "version": "1.6.12",
  "identifier": "mod.elite.launcher",
  "build": { "frontendDist": "ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "title": "DoW Launcher", "width": 1120, "height": 700, "minWidth": 900, "minHeight": 600, "resizable": true, "center": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required" }
    ],
    "security": { "csp": "default-src 'self'; img-src 'self' https: data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:" }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "deb", "nsis", "dmg"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "shortDescription": "Install, update and launch Elite Mod for Dawn of War II: Retribution",
    "category": "Game",
    "license": "MIT",
    "licenseFile": "installer-notice.txt",
    "windows": { "nsis": { "installerHooks": "installer-hooks.nsh", "languages": ["Russian", "English"] } }
  },
  "plugins": {
    "deep-link": { "desktop": { "schemes": ["elite"] } },
    "updater": {
      "pubkey": "",
      "endpoints": ["https://dow2ru.fintebtc.de/elite/dl/updater.json", "https://dow2.fintebtc.de/elite/dl/updater.json", "https://rts.fintebtc.de/elite/dl/updater.json", "https://github.com/dow2-launcher/Dow2-elite-launcher/releases/latest/download/updater.json"]
    }
  }
}
